# Platform API gateway (auth-service, attendflow-service). Leave empty in development:
# Vite proxies /api to http://localhost:8080 and /ws to ws://localhost:8081.
VITE_API_URL=https://api.career.xmus.me
# Optional. Defaults to VITE_API_URL with wss:// and /ws.
VITE_WS_URL=wss://api.career.xmus.me/ws
