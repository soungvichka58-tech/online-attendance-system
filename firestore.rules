rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /sessions/{sessionId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /attendance/{attendanceId} {
      allow read, delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      allow update: if false;

      allow create: if
        request.resource.data.keys().hasAll([
          'studentId', 'studentIdNormalized', 'studentName',
          'sessionId', 'sessionTitle', 'className', 'teacherId', 'submittedAt'
        ])
        && attendanceId == (request.resource.data.sessionId + '_' + request.resource.data.studentIdNormalized)
        && request.resource.data.submittedAt == request.time
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'active'
        && request.time >= get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.opensAt
        && request.time <= get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.closesAt;
    }
  }
}